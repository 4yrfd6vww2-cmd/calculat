{
  "name": "neirox-desktop",
  "version": "0.1.0",
  "description": "neirox — Умный Чат",
  "main": "main.js",
  "author": "neirox",
  "private": true,
  "devDependencies": {
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.example.neirox.desktop",
    "productName": "Neirox",
    "files": ["main.js", "preload.js", "build/icon.png", "app/**/*"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "Neirox-Windows.${ext}",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network",
      "icon": "build/icon.png",
      "artifactName": "Neirox-Linux.${ext}"
    },
    "mac": {
      "target": ["dir"],
      "category": "public.app-category.social-networking",
      "identity": null,
      "extendInfo": { "NSMicrophoneUsageDescription": "Микрофон нужен для голосовых сообщений и звонков" },
      "icon": "build/icon.png"
    }
  }
}
